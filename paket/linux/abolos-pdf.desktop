[Desktop Entry]
Type=Application
Name=Abolos PDF
GenericName=PDF-Reader
GenericName[en]=PDF Reader
Comment=PDFs lesen, durchsuchen, markieren und kommentieren – offline, ohne Abo
Comment[en]=Read, search, highlight and annotate PDFs – offline, no subscription
Exec=abolos-pdf %f
Icon=abolos-pdf
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
Keywords=PDF;Reader;Anmerkungen;Suche;
StartupWMClass=abolos-pdf
