<!-- SignPath-Artefaktkonfiguration "programm": GitHub-Artefakt (ZIP) mit abolos-pdf.exe;
     nur die eigene .exe wird signiert (Authenticode), fremde Dateien nicht -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="abolos-pdf.exe" product-name="Abolos PDF">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
